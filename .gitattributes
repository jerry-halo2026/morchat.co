# Ensure shell scripts always use LF line endings (needed for Docker on Windows)
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Default behavior
* text=auto
packages/ui/lib/agent-bot/engine/* text eol=lf

# theme-variables.test.ts compares this file character by character.
docs/theming.md text eol=lf

# Built-in agent skills are parsed as text: `builtin_skills_test` requires the
# SKILL.md frontmatter fence to start with LF, so a CRLF checkout on Windows
# fails it. Pin them (and their legacy copies) to LF like the other parity files.
server/internal/service/builtin_skills/** text eol=lf
server/internal/service/builtin_skills_legacy/** text eol=lf
