{
  "schema_key": "shotlist",
  "version": 1,
  "status": "draft",
  "title": "视频剪辑：镜头清单",
  "summary_path": "/title",
  "searchable_paths": ["/title", "/shots/*/text"],
  "tag_sets": [
    {
      "key": "selling_point",
      "name": "卖点",
      "cardinality": "multi",
      "values": [
        { "value": "price", "label_zh": "价格", "label_en": "Price", "sort": 1 },
        { "value": "gift", "label_zh": "赠品", "label_en": "Gift", "sort": 2 },
        { "value": "ingredient", "label_zh": "成分", "label_en": "Ingredient", "sort": 3 },
        { "value": "effect", "label_zh": "效果", "label_en": "Effect", "sort": 4 },
        { "value": "proof", "label_zh": "口碑", "label_en": "Proof", "sort": 5 },
        { "value": "pain-point", "label_zh": "痛点", "label_en": "Pain point", "sort": 6 }
      ]
    },
    {
      "key": "shot_size",
      "name": "景别",
      "cardinality": "single",
      "values": [
        { "value": "close-up", "label_zh": "特写", "label_en": "Close-up", "sort": 1 },
        { "value": "medium", "label_zh": "中景", "label_en": "Medium", "sort": 2 },
        { "value": "wide", "label_zh": "全景", "label_en": "Wide", "sort": 3 }
      ]
    },
    {
      "key": "rhythm",
      "name": "节奏",
      "cardinality": "single",
      "values": [
        { "value": "fast-cut", "label_zh": "快切", "label_en": "Fast cut", "sort": 1 },
        { "value": "steady", "label_zh": "匀速", "label_en": "Steady", "sort": 2 },
        { "value": "slow", "label_zh": "慢镜", "label_en": "Slow motion", "sort": 3 }
      ]
    },
    {
      "key": "scene",
      "name": "场景",
      "cardinality": "single",
      "values": [
        { "value": "indoor", "label_zh": "室内", "label_en": "Indoor", "sort": 1 },
        { "value": "outdoor", "label_zh": "户外", "label_en": "Outdoor", "sort": 2 },
        { "value": "shelf", "label_zh": "货架", "label_en": "Shelf", "sort": 3 },
        { "value": "studio", "label_zh": "直播间", "label_en": "Studio", "sort": 4 }
      ]
    }
  ],
  "enum_bindings": [
    { "path": "/properties/shots/items/properties/shot_size/enum", "tag_set": "shot_size" },
    { "path": "/properties/shots/items/properties/rhythm/enum", "tag_set": "rhythm" },
    { "path": "/properties/shots/items/properties/scene/enum", "tag_set": "scene" },
    { "path": "/properties/shots/items/properties/selling_points/items/enum", "tag_set": "selling_point" }
  ],
  "json_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "title", "duration_ms", "aspect_ratio", "shots"],
    "properties": {
      "schema_version": { "const": "shotlist.v1" },
      "title": { "type": "string", "minLength": 1, "maxLength": 120 },
      "duration_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
      "aspect_ratio": { "enum": ["9:16", "16:9", "1:1"] },
      "shots": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "start_ms", "end_ms", "shot_size", "scene", "rhythm"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "start_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 1 },
            "shot_size": { "enum": ["close-up", "medium", "wide"] },
            "scene": { "enum": ["indoor", "outdoor", "shelf", "studio"] },
            "rhythm": { "enum": ["fast-cut", "steady", "slow"] },
            "selling_points": {
              "type": "array",
              "items": {
                "enum": ["price", "gift", "ingredient", "effect", "proof", "pain-point"]
              }
            },
            "text": { "type": "string", "maxLength": 200 },
            "product_ref": { "type": "string", "maxLength": 80 }
          }
        }
      }
    }
  }
}
