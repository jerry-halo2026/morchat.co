{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://morechat.co/contracts/library/manifest.schema.json",
  "title": "Library domain manifest",
  "description": "One department's artifact contract plus its tag sets. A manifest is data: the platform never hard-codes a domain's fields or tags.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_key", "version", "status", "title", "json_schema", "tag_sets", "enum_bindings"],
  "properties": {
    "schema_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Stable machine key, unique inside its domain (e.g. shotlist, clause-set)."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "active", "deprecated"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "summary_path": {
      "type": "string",
      "pattern": "^/",
      "description": "JSON Pointer into the artifact that names it in search results. Keep it short."
    },
    "searchable_paths": {
      "type": "array",
      "items": { "type": "string", "pattern": "^/" },
      "default": []
    },
    "tag_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "cardinality", "values"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "name": { "type": "string", "minLength": 1 },
          "cardinality": { "enum": ["single", "multi"] },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label_zh", "label_en"],
              "properties": {
                "value": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
                "label_zh": { "type": "string", "minLength": 1 },
                "label_en": { "type": "string", "minLength": 1 },
                "sort": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "enum_bindings": {
      "type": "array",
      "description": "Where the artifact schema constrains a field to a tag set's values. The checker compares both sides, so a value cannot exist in one place only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "tag_set"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "tag_set": { "type": "string" }
        }
      }
    },
    "json_schema": {
      "type": "object",
      "description": "The artifact contract itself (draft-07). Must describe an object.",
      "required": ["type", "properties", "required", "additionalProperties"],
      "properties": {
        "type": { "const": "object" },
        "additionalProperties": { "const": false }
      }
    }
  }
}
