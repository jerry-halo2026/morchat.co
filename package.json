{
  "name": "multica",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs up",
    "dev:api": "node scripts/dev.mjs api",
    "dev:daemon": "node scripts/dev.mjs daemon",
    "dev:status": "node scripts/dev.mjs status",
    "dev:stop": "node scripts/dev.mjs stop",
    "dev:env": "node scripts/dev.mjs env",
    "db:migrate": "node scripts/dev.mjs migrate",
    "dev:web": "turbo dev --filter=@morechat/web",
    "dev:docs": "turbo dev --filter=@morechat/docs",
    "dev:desktop": "turbo dev --filter=@morechat/desktop",
    "dev:desktop:staging": "turbo dev:staging --filter=@morechat/desktop",
    "dev:mobile": "pnpm -C apps/mobile dev",
    "dev:mobile:staging": "pnpm -C apps/mobile dev:staging",
    "dev:mobile:prod": "pnpm -C apps/mobile dev:prod",
    "ios:mobile": "pnpm -C apps/mobile ios",
    "ios:mobile:staging": "pnpm -C apps/mobile ios:staging",
    "ios:mobile:prod": "pnpm -C apps/mobile ios:prod",
    "ios:mobile:device": "pnpm -C apps/mobile ios:device",
    "ios:mobile:device:staging": "pnpm -C apps/mobile ios:device:staging",
    "ios:mobile:device:staging:release": "pnpm -C apps/mobile ios:device:staging:release",
    "ios:mobile:device:prod": "pnpm -C apps/mobile ios:device:prod",
    "ios:mobile:device:prod:release": "pnpm -C apps/mobile ios:device:prod:release",
    "build": "turbo build --filter=!@morechat/mobile",
    "typecheck": "turbo typecheck --filter=!@morechat/mobile",
    "test": "turbo test --filter=!@morechat/mobile",
    "lint": "turbo lint --filter=!@morechat/mobile",
    "knip": "knip",
    "check:ui-exports": "node scripts/check-ui-wildcard-exports.mjs",
    "check:ui-radii": "node scripts/check-ui-radius-tokens.mjs",
    "check:deps-catalog": "node scripts/check-dependency-catalog.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add": "cd packages/ui && npx shadcn@latest add",
    "generate:brand": "node scripts/brand/generate.mjs",
    "generate:attachment-text-preview": "node scripts/generate-attachment-text-preview.mjs",
    "generate:reserved-slugs": "node scripts/generate-reserved-slugs.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ],
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "@xmldom/xmldom": "^0.8.13",
      "postcss": "8.5.26",
      "uuid": "11.1.1",
      "shell-quote": "1.9.0",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@5>brace-expansion": "2.1.4",
      "minimatch@9>brace-expansion": "2.1.4",
      "minimatch@10>brace-expansion": "5.0.9",
      "builder-util-runtime": "9.7.0"
    },
    "patchedDependencies": {
      "expo-modules-core@57.0.21": "apps/mobile/patches/expo-modules-core@57.0.21.patch"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "knip": "^6.32.2",
    "pg": "^8.20.0",
    "turbo": "^2.5.4",
    "typescript": "catalog:"
  }
}
