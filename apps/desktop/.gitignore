node_modules
dist
out
.DS_Store
.eslintcache
*.log*
# CLI binary bundled at build time (from server/bin/)
resources/bin/
# DSH runtime + portable node are bundled at build time (scripts/bundle-dsh.mjs)
resources/dsh/
resources/node/
# Portable python (embedded 3.12 + pip) and git (MinGit) are fetched at build
# time (scripts/fetch-runtime-tools.mjs). 100 MB of binaries that rebuild
# reproducibly from two pinned URLs does not belong in history.
resources/python/
resources/git/
# DSH profile bundle is generated by the same script; its state belongs to the
# build that produced it, not to the checkout.
resources/dsh-profile/
