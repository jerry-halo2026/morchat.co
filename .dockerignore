# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Dockerfile.web needs the web workspace and root dependency patch inputs.
# Default-exclude other app files so they do not enter the build context.
/apps/*
!/apps/web/
!/apps/mobile
/apps/mobile/*
!/apps/mobile/patches
!/apps/mobile/patches/**

# Repository-only tooling
/.github/
/deploy/
/scripts/

# Nested build artefacts and the desktop's bundled runtime/toolchain.
# Without these the build context grows past 6 GB (packages/*/node_modules and
# apps/desktop/resources hold the portable python/git/node/dsh trees).
**/node_modules
**/.next
**/dist
**/.turbo
/apps/desktop/resources
/apps/desktop/dist
/local
/.local
