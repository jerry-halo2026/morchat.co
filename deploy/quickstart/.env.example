# morechat.co — 一键部署（quickstart）环境变量示例
#
# 复制成 .env 后即可使用：
#   cp .env.example .env        # Linux/macOS
#   Copy-Item .env.example .env # Windows
# 然后按下面的注释把 3 个密钥换成真随机值 —— 或者直接跑 install.sh /
# install.ps1，它会自动生成并回填（推荐，见 README.md）。
#
# 规则：本文件只会出现示例/占位值，任何真实密钥都不进仓库。
# 必填项在 docker-compose.yml 里用 ${VAR:?err} 引用，留空或缺失会直接启动失败。

# ============================== 必填 ==============================

# 数据库名。postgres 容器创建库用它；DATABASE_URL 里也要一致。
POSTGRES_DB=multica

# 数据库用户名。同上，必须与 DATABASE_URL 一致。
POSTGRES_USER=multica

# 数据库密码。**必须换掉**：openssl rand -hex 16。改这里也要同步改 DATABASE_URL。
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_16

# API 的数据库连接串（服务名 postgres 由 compose 网络解析）。密码与上一行一致。
DATABASE_URL=postgres://multica:REPLACE_WITH_openssl_rand_hex_16@postgres:5432/multica?sslmode=disable

# API 监听端口（同时是宿主机发布端口，只绑 127.0.0.1）。main.go 读它，缺省 8080。
PORT=8080

# 运行环境。production 会开启安全检查：JWT_SECRET 为空或占位值时 API 拒绝启动。
APP_ENV=production

# JWT / daemon token / 附件签名 HMAC 的签名密钥。**必须换掉**：openssl rand -hex 32。
# 换了它，所有已登录会话都会失效。
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# VCS 集成（Forgejo / Gitea / GitLab）与 Qoder token 的静态加密密钥。
# **必须换掉**：必须是 base64 编码的 32 字节 → openssl rand -base64 32
# （注意不是 hex：hex 出来的 64 字符按 base64 解码是 48 字节，会被拒绝）。
MULTICA_VCS_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_32

# 前端公开源。CORS 和 WebSocket 的 Origin 校验都认这个值：浏览器用哪个地址
# 打开，就填哪个，一字不差（协议+主机+端口，不带路径）。换域名/换 IP 必改。
FRONTEND_ORIGIN=http://localhost:3000

# 应用对外 URL：邮件里的链接、CLI/daemon 安装命令用它。一般与 FRONTEND_ORIGIN 相同。
MULTICA_APP_URL=http://localhost:3000

# ======================= 可选：仅 Compose 使用 =======================

# 前端宿主机端口（容器内固定 3000，只绑 127.0.0.1）。默认 3000。
# WEB_PORT=3000

# CORS / WebSocket 允许的源，逗号分隔。留空则回落到 FRONTEND_ORIGIN。
# 想同时用 localhost 和 127.0.0.1 打开：
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================== 可选：Caddy 反代 + TLS（形态二） ====================
# caddy 服务挂在 compose profile `tls` 下：**默认不启动**。
# 打开下面这一行 = 让 `docker compose up -d` 一并拉起 caddy。
# 关掉（注释掉）= caddy 不参与默认 up；仍可 `docker compose up -d caddy` 单独起。
# COMPOSE_PROFILES=tls

# 站点地址。有三种情形：
#   1) 有公网域名：DOMAIN=app.example.com，DNS A/AAAA 已指向本机、80/443 可达 →
#      Caddy 自动签发 Let's Encrypt 证书（此时同时设 TLS_SNIPPET=tls_acme）。
#   2) 只有本机/内网、不签公信证书：DOMAIN=localhost（或 127.0.0.1）→
#      Caddy 用**内部 CA 自签**（tls_local，默认值）。
#      访问：`curl -k https://localhost/`，浏览器需先信任根证书：
#        docker compose exec caddy cat /data/caddy/pki/authorities/local/root.crt
#      这是纯本地/内网自测的默认路径，不需要任何域名。
#   3) 想用别的宿主机端口（例如 80/443 被占用）：设 HTTP_PORT / HTTPS_PORT。
#
# DOMAIN=localhost

# ACME 账户邮箱（Let's Encrypt 到期通知 / 账户找回）。只有公网域名 + tls_acme
# 有意义；本地自签时留空即可。
# ACME_EMAIL=you@example.com

# TLS 片段选择：tls_local（内部 CA 自签，默认）| tls_acme（ACME 公信证书）。
# TLS_SNIPPET=tls_local

# Caddy 对外端口（宿主机侧）。默认 80 / 443；443/udp 是 HTTP/3。
# HTTP_PORT=80
# HTTPS_PORT=443

# 注意：DOMAIN 一旦不是 localhost，就必须把 FRONTEND_ORIGIN 与
# MULTICA_APP_URL 一起改成 https://<DOMAIN>，否则 WebSocket 的 Origin 校验
# 会 403（默认只放行 localhost）。

# ========================== 可选：邮件 ==========================
# 两种方式二选一；SMTP_HOST 一旦设置就优先于 Resend。
# 都不配时验证码会打印在 API 容器日志里（见 README「首次登录」）。

# Resend（SaaS，云端部署推荐）：在 resend.com 建 key 并验证发信域名。
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=noreply@example.com

# SMTP 中继（自建/内网）：SMTP_HOST 为空即不启用。
# 465 端口会自动走 implicit TLS；SMTP_TLS=implicit 可强制。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_TLS=starttls

# ===================== 可选：对象存储（S3） =====================
# 留空则附件写本地卷 api_uploads。AWS_ENDPOINT_URL 用于 MinIO / R2 / RustFS
# 等 S3 兼容端点；S3_USE_PATH_STYLE 留空时按「有 endpoint 即 true」推断。

# S3_BUCKET=my-bucket-name
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=
# S3_USE_PATH_STYLE=

# ======================= 可选：Supabase 身份 =======================
# 用 Supabase 托管身份（Auth）时填这两项；不用则留空，走邮箱验证码登录。
# 两项都填才会启用；API 会通过 /auth/supabase/config 把它暴露给前端。
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
